---
import Layout from "../../layouts/Layout.astro";
import fs from "fs";
import path from "path";
import RecipeReviewPreview from '../../components/RecipeReviewPreview.astro';
import { parseRecipePreview } from '../../lib/recipe-review';

const isDev = import.meta.env.DEV;
if (!isDev) return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', 'no-store');
const trashDir = path.resolve(process.cwd(), ".trash");

interface TrashedRecipe {
  slug: string;
  title: string;
  preview?: ReturnType<typeof parseRecipePreview>;
  raw: string;
  error?: string;
}

let trashed: TrashedRecipe[] = [];

if (isDev && fs.existsSync(trashDir)) {
  const files = fs.readdirSync(trashDir, { withFileTypes: true }).filter((file) => file.isFile() && file.name.endsWith('.md')).map((file) => file.name);
  trashed = files.map((file) => {
    const slug = file.replace(".md", "");
    const content = fs.readFileSync(path.join(trashDir, file), "utf-8");
    const titleMatch = content.match(/title:\s*(.+)/);
    const title = titleMatch ? titleMatch[1].trim() : slug;
    try {
      const preview = parseRecipePreview(content);
      return { slug, title: preview.data.title, preview, raw: content };
    } catch (error) {
      return { slug, title, raw: content, error: error instanceof Error ? error.message : 'Unable to parse recipe.' };
    }
  }).sort((a, b) => a.title.localeCompare(b.title));
}
---

<Layout title="Trashed recipes | Gustoso">
  <div class="min-h-dvh bg-neutral-900 text-gray-100">
    <div class="flex flex-col bg-neutral-800 max-w-2xl m-auto min-h-dvh">
      <div class="flex items-center justify-between px-4 py-4 border-b-2 border-neutral-700">
        <h1 class="text-2xl font-bold">Trashed Recipes</h1>
        <a
          href="/"
          class="text-sm text-neutral-400 hover:text-white transition"
        >
          ← Back to index
        </a>
      </div>

      <p class="px-4 py-3 text-sm text-neutral-400">Preview ingredients, instructions, and notes without restoring the file. Notes are shown as plain text for safety.</p>
      {trashed.length === 0 ? (
        <div class="p-6 text-center text-neutral-400">
          <p class="text-lg">No trashed recipes.</p>
          <p class="mt-2 text-sm">Discarded recipes will appear here.</p>
        </div>
      ) : (
        <div class="flex flex-col">
          {trashed.map((r) => (
            <div class="p-3 border-b border-neutral-700">
              <div class="flex items-center justify-between gap-3">
                <div class="flex flex-col min-w-0">
                  <span class="font-semibold truncate">{r.title}</span>
                  <span class="text-xs text-neutral-500">{r.slug}.md</span>
                </div>
                <button
                  data-slug={r.slug}
                  data-action="restore"
                  class="cursor-pointer bg-blue-600 hover:bg-blue-500 text-white px-3 py-1 text-xs rounded-3xl transition shrink-0 ml-2"
                >
                  Restore
                </button>
              </div>
              <details class="mt-3">
                <summary class="w-fit cursor-pointer text-sm font-bold text-blue-300 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4">Preview recipe</summary>
                <div class="mt-3 rounded border border-neutral-600 bg-neutral-900 p-4">
                  {r.preview ? <RecipeReviewPreview {...r.preview} /> : <>
                    <p class="text-sm text-yellow-300">This recipe could not be parsed. The original file is shown below; it has not been changed.</p>
                    <p class="mt-2 whitespace-pre-wrap text-xs text-neutral-400">{r.error}</p>
                    <pre class="mt-3 overflow-auto whitespace-pre-wrap break-words text-xs">{r.raw}</pre>
                  </>}
                </div>
              </details>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  import { actions } from "astro:actions";

  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-action]");
    if (!btn) return;

    const slug = btn.dataset.slug;
    const action = btn.dataset.action;
    if (!slug || action !== "restore") return;

    e.preventDefault();
    btn.disabled = true;

    try {
      const { error } = await actions.restoreRecipe({ slug });
      if (error) throw new Error(error.message);
      window.location.reload();
    } catch (err: any) {
      console.error("Restore failed:", err);
      alert(err.message || "Restore failed");
    } finally {
      btn.disabled = false;
    }
  });
</script>
